{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv sync",
            "type": "shell",
            "command": "uv",
            "args": [
                "sync",
                "--locked"
            ],
            "problemMatcher": "$python",
        },
        {
            "label": "pytest",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "pytest",
                "--cov",
                "--tb=native"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$python",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "ruff",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "ruff",
                "check"
            ],
            "problemMatcher": "$python",
        }
    ]
}