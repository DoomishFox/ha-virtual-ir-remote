    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv sync",
            "type": "shell",
            "command": "uv",
            "args": [
                "sync",
                "--locked"
            ],
            "problemMatcher": []
        },
        {
            "label": "pytest",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "pytest",
                "--cov"
            ]
        },
        {
            "label": "ruff",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "--locked",
                "ruff",
                "check"
            ]
        }
    ]
}